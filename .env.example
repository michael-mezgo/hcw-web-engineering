# Copy to .env (cp .env.example .env)

# Generate two different values with openssl rand -hex 32.
POSTGRES_PASSWORD=
SESSION_SECRET=

# Replace <password> with the value of POSTGRES_PASSWORD for host-side scripts.
DATABASE_URL=postgres://bears:<password>@localhost:5432/bears

AUTH_RATE_LIMIT_MAX=5
CORS_ORIGINS=http://localhost:4173,http://localhost:5173,http://localhost:8080

MODERATOR_PASSWORD=
